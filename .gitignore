node_modules/
*.tgz
test/*.svg
.DS_Store

# ── benchmark scratch and measurements ────────────────────────────────────────
# A report measures one model on one day; it is not a source artifact. The
# offline grader also writes into a scratch workspace. Neither belongs in git —
# a run is reproducible from benchmark/tasks.json plus the commit it ran against.
benchmark/reports/
benchmark/.offline-workspace/
benchmark/_probe-workspace/

# Each benchmark task now runs in its OWN scratch workspace under the system temp
# directory, so run artifacts should no longer land here. These patterns stay as
# a backstop for a task run by hand (`node benchmark/run.mjs --model --task <id>`
# with a custom cwd) and for anything the tools write during development: the
# list is the full set of extensions the toolset can emit.
/*.svg
/*.fasta
/*.fa
/*.fq
/*.gb
/*.gbk
/*.ab1
/*.seq
/*.nwk
/*.bib
/*.csv
/*.json
